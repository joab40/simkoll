# Supabase backend. Keep the server/service-role key secret; never use VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternative name accepted by the server when SUPABASE_SECRET_KEY is absent.
# SUPABASE_SERVICE_ROLE_KEY=

# Login and signing. Use long random values; see docs/environment-variables.md.
SIMKOLL_SWIMMER_CODE=
# Optional legacy shared coach code. Personal coach accounts are preferred.
SIMKOLL_COACH_CODE=
# Used once to create the first superadmin; also a fallback signing secret.
SIMKOLL_COACH_BOOTSTRAP_TOKEN=
# Strongly recommended in production; changing it signs out coach sessions.
COACH_SESSION_SECRET=
# Protects the scheduled Tempus sync endpoint. Set in Vercel so Cron requests
# include Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional salt for pseudonymous IP hashes in audit logs.
AUDIT_LOG_SALT=

# OpenAI. Required for most AI features; model variables below are optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_WORKOUT_IMAGE_MODEL=
OPENAI_COMPETITION_MODEL=gpt-4o
# Separate two-stage competition-program image/PDF analysis.
OPENAI_COMPETITION_PROGRAM_MODEL=gpt-6.1-sol

# Optional Vercel AI Gateway for trend analysis if direct OpenAI is not used.
# VERCEL_OIDC_TOKEN is normally supplied by Vercel; otherwise set a Gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=inclusionai/ling-3.0-flash-fin-free

# Optional Google Drive source for imported workout documents.
GOOGLE_DRIVE_API_KEY=
# GOOGLE_DRIVE_FOLDER_ID= (defaults to the configured Simkoll folder)

# Web Push (all three values required to turn on push notifications).
# Generate once with: npx web-push generate-vapid-keys --json
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Example: mailto:your-club-contact@example.org
WEB_PUSH_SUBJECT=
